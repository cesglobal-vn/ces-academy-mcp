{
  "name": "ces-academy-mcp",
  "version": "1.1.0",
  "description": "MCP server cho Claude: đăng sách (PDF, ảnh bìa, video giới thiệu) lên CES Academy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": ">=20"
  },
  "bin": {
